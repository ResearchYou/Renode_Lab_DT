FROM codercom/code-server:4.95.3

USER root
RUN rm -f /etc/sudoers.d/nopasswd \
    && SUDO_FORCE_REMOVE=yes apt-get purge -y --auto-remove sudo \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clangd \
        clang \
        gcc-arm-none-eabi \
        libnewlib-arm-none-eabi \
        libstdc++-arm-none-eabi-newlib \
        cmake \
        make \
        python3 \
        git \
        ca-certificates \
        nginx \
        docker.io \
        curl \
    && curl -SL "https://github.com/docker/compose/releases/download/v2.26.1/docker-compose-linux-x86_64" -o /usr/local/bin/docker-compose \
    && chmod +x /usr/local/bin/docker-compose \
    && rm -rf /var/lib/apt/lists/*

USER coder
RUN code-server --install-extension llvm-vs-code-extensions.vscode-clangd \
    && code-server --install-extension tomoki1207.pdf

COPY --chown=coder:coder ide/code-server/config.yaml /home/coder/.config/code-server/config.yaml
COPY --chown=coder:coder ide/code-server/User/settings.json /home/coder/.local/share/code-server/User/settings.json
COPY --chown=coder:coder ide/code-server/User/keybindings.json /home/coder/.local/share/code-server/User/keybindings.json

USER root
COPY docker/scripts/start_ide.sh /usr/local/bin/start_ide.sh
COPY ide/runner.py                /usr/local/bin/runner.py
RUN chmod +x /usr/local/bin/start_ide.sh /usr/local/bin/runner.py

COPY docker-compose.yml /home/coder/docker-compose.yml
COPY --chown=coder:coder firmware/ /opt/challenge-seed/firmware/
COPY --chown=coder:coder ide/problem/ /opt/challenge-seed/problem/
RUN mkdir -p /home/coder/challenge/output \
    && chown -R coder:coder /home/coder/challenge /home/coder/docker-compose.yml /opt/challenge-seed

COPY --chown=coder:coder ide/panel/      /home/coder/panel/
COPY --chown=coder:coder ide/nginx.conf  /home/coder/nginx.conf

# Entrypoint runs as root so the runner can reach the Docker socket;
# code-server is exec'd as coder inside the script.
ENTRYPOINT ["/usr/local/bin/start_ide.sh"]
