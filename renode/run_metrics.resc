# Renode script for RP2040 Digital Twin — with metrics collection (Option D)
# Enables the built-in metrics analyzer to capture CPU execution data.

path add @/opt/renode-rp2040

include @boards/initialize_raspberry_pico.resc

sysbus LoadELF @/workspace/build/firmware.elf

sysbus.cpu0 VectorTableOffset 0x00000000
sysbus.cpu1 VectorTableOffset 0x00000000

# Capture UART to file as usual
sysbus.uart0 CreateFileBackend @/workspace/output/uart_output.txt true

# Log SIO peripheral accesses (GPIO ground truth)
logFile @/workspace/output/renode.log true
sysbus LogPeripheralAccess sysbus.sio

# Enable built-in metrics collection
machine EnableMetrics @/workspace/output/metrics.bin

# Run for 15 virtual seconds
emulation RunFor "00:00:15"

echo "Emulation finished — metrics written to /workspace/output/metrics.bin"
quit
