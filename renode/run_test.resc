# Renode scenario: STM32F4 YubiKey-like challenge-response token
#
# A single STM32F4 Discovery board runs token firmware. A custom memory-mapped
# MockUSBHIDHost peripheral at 0x50000000 drives fixed 64-byte HID-like reports.

include @/workspace/renode/peripherals/MockUSBHIDHost.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.Miscellaneous.MockUSBHIDHost"

logFile @/workspace/output/renode.log true

mach create "token"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

machine LoadPlatformDescriptionFromString "mockUsb: Miscellaneous.MockUSBHIDHost @ sysbus 0x50000000"

sysbus LoadELF @/workspace/build/token.elf
sysbus.usart1 CreateFileBackend @/workspace/output/token_uart.txt true

logLevel -1 sysbus.mockUsb

echo "Starting STM32F4 mock HID security-token scenario..."
emulation RunFor "00:00:03"
echo "Scenario complete"
quit
